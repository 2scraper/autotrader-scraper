# autotrader-scraper — credentials and defaults
#
# Copy this file to `.env` next to the scripts and fill in what you use:
#
#     cp .env.example .env
#
# `.env` is in .gitignore (as is every `.env.*` but this one). Keep it
# there. A secret passed on a command line is readable by anything that can
# run `ps` and lands in your shell history, which is why none of these has a
# flag you are expected to type.
#
# Precedence, highest first:
#
#     explicit CLI flag  >  exported environment variable  >  .env  >  default
#
# Check what was picked up, without printing any secret:
#
#     python3 env_config.py
#
# Every variable below is one this code actually reads, and every variable
# the code reads is below. smoke_test.py asserts the two sets are equal in
# both directions.
#
# READ THIS FIRST: on this site you need an exit, and it has to be a US
# RESIDENTIAL one, used by a HEADFUL browser.
#
# Measured 2026-09-24: autotrader.com answered plain curl, headless Chromium
# and headful Chromium from a datacentre address alike with a 3.7 KB "page
# unavailable" page under HTTP 200. Headful Chromium through a US residential
# proxy was served every time. So AUTOTRADER_PROXY below is the one line
# most runs need.


# --- 2Captcha -------------------------------------------------------------
# One key, four separately-billed products: captcha solving, the Scraping
# Browser API, proxies and fingerprints. https://2captcha.com
#
# No captcha stands in front of this site's pages: none appeared on any page
# fetched on 2026-09-24, served or refused. The refusal page carries a
# reCAPTCHA of its own, and it guards a form that files an unblock request
# with the site's support staff; this repo never solves or submits it. So
# a normal run spends nothing on solving.
#
# This key is also what --fingerprint and the Scraper API client use. Those
# are separate subscriptions from solving.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# --- Scraping Browser API -------------------------------------------------
# A remote browser you do not run or patch, with a persistent profile and a
# chosen exit country. Used by --cdp-endpoint.
#
#   country-  picks the exit country. This site is US-only: use `us`.
#   pid-      a profile with persistent cookies. ONE live connection each,
#             capped per account. Reuse pids rather than minting one per
#             run, and expect a 500 (`profile_locked`, exit 5) while another
#             run still holds this one.
#
# Measured 2026-09-24 with the one country-us profile available: the site
# answered it with the same "page unavailable" as a datacentre address, 2 of
# 2. That is one profile on one day, recorded as such; the README says what
# was and was not tried.
#
# Selenium cannot use this: chromedriver's `debuggerAddress` takes a bare
# host:port with nowhere to put a password. Playwright and pyppeteer can.
#
# The credentials in a profile expire in about a day, so never paste a
# working one anywhere that is committed.
AUTOTRADER_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222

# --- Proxy ----------------------------------------------------------------
# One URL here, or --proxy-file with one per line for a pool. A pool is what
# spreads a run's volume, and --concurrency without one just sends N times
# the request rate from a single address.
#
# Region: the United States, residential. `-region-us` in a 2Captcha
# residential login.
#
# The credentials never reach the browser's command line: they go through
# the driver's own fields, and logs mask them while keeping host and port.
# Selenium's --proxy-server cannot authenticate at all, so that engine
# strips the credentials and warns — use Playwright or pyppeteer with this.
AUTOTRADER_PROXY=http://{user}-region-us:{password}@na.proxy.2captcha.com:2334

# --- Default target -------------------------------------------------------
# Saves retyping --url. A search as the site builds it, with any of its own
# filters in the query string, or one detail page:
#
#   https://www.autotrader.com/cars-for-sale/all-cars/toyota/camry/new-york-ny
#   https://www.autotrader.com/cars-for-sale/used-cars/ford/f150/los-angeles-ca?searchRadius=50
#   https://www.autotrader.com/cars-for-sale/vehicle/{listing id}
AUTOTRADER_URL=https://www.autotrader.com/cars-for-sale/all-cars/toyota/camry/new-york-ny

# Deliberately NOT here: an output prefix. `--out` already carries a
# non-empty default, so the loader, which only fills UNSET values, would
# never see it. The variable would be silently inert.
